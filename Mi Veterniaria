using System;
using System.IO.Pipelines;

namespace ProyectoFinal
{
    class Program
    {
        public class Usuario()
        {
            public string NombreUsuario {get; set;}
            public string Correo {get; set;}
            public string Telefono {get; set;}
        }
        public class Mascota()
        {
            public string NombreMascota {get; set;}
            public string Especie {get; set;}
            public string Edad {get; set;}
            public string UsuarioPropietario {get; set;}
        }
        public class Cita()
        {
            public string UsuarioNombre {get; set;}
            public string MascotaNombre {get; set;}
            public DateTime Fecha {get; set;}
        }

        static string registrarUsuario(Usuario[] usuarios, int indiceUsuario)
        {
            Console.Clear();
            Console.WriteLine("Ingrese nombre de usuario:");
            string NombreUsuario = Console.ReadLine();
            Console.WriteLine("Ingrese el correo:");
            string Correo = Console.ReadLine();
            Console.WriteLine("Ingrese el número de teléfono:");
            string Telefono = Console.ReadLine();

            if (indiceUsuario < usuarios.Length)
            {
                Usuario usuario = new Usuario();
                usuario.NombreUsuario = NombreUsuario;
                usuario.Correo = Correo;
                usuario.Telefono = Telefono;

                usuarios[indiceUsuario] = usuario;

                string resultado = $"El usuario {NombreUsuario} se creó correctamente.";
                return resultado;
            }
            return "No hay espacio para más usuarios.";
        }
        static string registarMascota(Mascota[] mascotas, Usuario[] usuarios, int indiceMascota)
        {
            Console.Clear();
            Console.WriteLine("Usuarios disponibles:");
            int usuariosActivos = 0;
            for (int i = 0; i < usuarios.Length; i++)
            {
                if (usuarios[i] != null)
                {
                    Console.WriteLine($"{i + 1}. {usuarios[i].NombreUsuario}");
                    usuariosActivos++;
                }
            }
            
            if (usuariosActivos == 0)
            {
                return "No hay usuarios registrados. Registre un usuario primero.";
            }
            
            Console.WriteLine("Seleccione el número del usuario propietario:");
            string seleccionUsuario = Console.ReadLine();
            int indiceUsuarioSeleccionado = int.Parse(seleccionUsuario) - 1;
            
            if (indiceUsuarioSeleccionado < 0 || indiceUsuarioSeleccionado >= usuarios.Length || usuarios[indiceUsuarioSeleccionado] == null)
            {
                return "Usuario inválido.";
            }
            
            Console.WriteLine("Ingrese nombre de la mascota:");
            string NombreMascota = Console.ReadLine();
            Console.WriteLine("Ingrese la especie:");
            string Especie = Console.ReadLine();
            Console.WriteLine("Ingrese la edad:");
            string Edad = Console.ReadLine();

            if (indiceMascota < mascotas.Length)
            {
                Mascota mascota = new Mascota();
                mascota.NombreMascota = NombreMascota;
                mascota.Especie = Especie;
                mascota.Edad = Edad;
                mascota.UsuarioPropietario = usuarios[indiceUsuarioSeleccionado].NombreUsuario;

                mascotas[indiceMascota] = mascota;

                string resultado = $"La mascota {NombreMascota} se creó correctamente y fue asignada a {usuarios[indiceUsuarioSeleccionado].NombreUsuario}.";
                return resultado;
            }
            return "No hay espacio para más mascotas.";
        }
        
        static string agendarCita(Cita[] citas, Usuario[] usuarios, Mascota[] mascotas, int indiceCita)
        {
            Console.Clear();
            Console.WriteLine("Usuarios disponibles:");
            int usuariosActivos = 0;
            for (int i = 0; i < usuarios.Length; i++)
            {
                if (usuarios[i] != null)
                {
                    Console.WriteLine($"{i + 1}. {usuarios[i].NombreUsuario}");
                    usuariosActivos++;
                }
            }
            
            if (usuariosActivos == 0)
            {
                return "No hay usuarios registrados.";
            }
            
            Console.WriteLine("Seleccione el número del usuario:");
            string seleccionUsuario = Console.ReadLine();
            int indiceUsuarioSeleccionado = int.Parse(seleccionUsuario) - 1;
            
            if (indiceUsuarioSeleccionado < 0 || indiceUsuarioSeleccionado >= usuarios.Length || usuarios[indiceUsuarioSeleccionado] == null)
            {
                return "Usuario inválido.";
            }

            Console.WriteLine("Mascotas del usuario:");
            int mascotasDelUsuario = 0;
            for (int i = 0; i < mascotas.Length; i++)
            {
                if (mascotas[i] != null && mascotas[i].UsuarioPropietario == usuarios[indiceUsuarioSeleccionado].NombreUsuario)
                {
                    Console.WriteLine($"{i + 1}. {mascotas[i].NombreMascota} ({mascotas[i].Especie})");
                    mascotasDelUsuario++;
                }
            }
            
            if (mascotasDelUsuario == 0)
            {
                return "Este usuario no tiene mascotas registradas.";
            }
            
            Console.WriteLine("Seleccione el número de la mascota:");
            string seleccionMascota = Console.ReadLine();
            int indiceMascotaSeleccionada = int.Parse(seleccionMascota) - 1;
            
            if (indiceMascotaSeleccionada < 0 || indiceMascotaSeleccionada >= mascotas.Length || mascotas[indiceMascotaSeleccionada] == null)
            {
                return "Mascota inválida.";
            }
            
            Console.WriteLine("Ingrese la fecha de la cita (dd/MM/yyyy):");
            string fechaStr = Console.ReadLine();
            DateTime fecha = DateTime.ParseExact(fechaStr, "dd/MM/yyyy", null);
            
            if (indiceCita < citas.Length)
            {
                Cita cita = new Cita();
                cita.UsuarioNombre = usuarios[indiceUsuarioSeleccionado].NombreUsuario;
                cita.MascotaNombre = mascotas[indiceMascotaSeleccionada].NombreMascota;
                cita.Fecha = fecha;
                
                citas[indiceCita] = cita;
                
                string resultado = $"Cita agendada para {cita.UsuarioNombre} con la mascota {cita.MascotaNombre} el {cita.Fecha:dd/MM/yyyy}.";
                return resultado;
            }
            return "No hay espacio para más citas.";
        }
        
        static string mostrarCitas(Cita[] citas)
        {
            Console.Clear();
            Console.WriteLine("---------------------------");
            Console.WriteLine("\tCitas agendadas");
            Console.WriteLine("---------------------------");
            
            int citasRegistradas = 0;
            for (int i = 0; i < citas.Length; i++)
            {
                if (citas[i] != null)
                {
                    Console.WriteLine($"\nCita {citasRegistradas + 1}:");
                    Console.WriteLine($"  Usuario: {citas[i].UsuarioNombre}");
                    Console.WriteLine($"  Mascota: {citas[i].MascotaNombre}");
                    Console.WriteLine($"  Fecha: {citas[i].Fecha:dd/MM/yyyy}");
                    citasRegistradas++;
                }
            }
            
            if (citasRegistradas == 0)
            {
                return "No hay citas agendadas.";
            }
            Console.WriteLine("---------------------------");
            
            Console.WriteLine("\nPresione una tecla para continuar...");
            Console.ReadKey();
            return "";
        }
        static void Main(string [] args)
        {
            string resultado = "";
            char opc;
            Usuario[] usuarios = new Usuario[5];
            Mascota[] mascotas = new Mascota[5];
            Cita[] citas = new Cita[5];
            
            int indiceUsuario = 0;
            int indiceMascota = 0;
            int indiceCita = 0;
            
            do
            {
                Console.Clear();
                Console.WriteLine("---------------------------");
                Console.WriteLine("Bienvenido a Mi Veterinaria");
                Console.WriteLine("---------------------------");
                Console.WriteLine("\n1. Registrar usuario\n2. Registrar mascota\n3. Agendar Cita\n4. Mostrar Citas\n5. Salir");
                Console.WriteLine("---------------------------");
            
                if (resultado != "")
                {
                    Console.WriteLine($"{resultado}");
                }
                
                opc = Console.ReadKey().KeyChar;  
                switch (opc)
                {
                    case '1':
                        resultado = registrarUsuario(usuarios, indiceUsuario);
                        if (resultado.Contains("correctamente"))
                        {
                            indiceUsuario++;
                        }
                        break;
                    case '2':
                        resultado = registarMascota(mascotas, usuarios, indiceMascota);
                        if (resultado.Contains("correctamente"))
                        {
                            indiceMascota++;
                        }
                        break;
                    case '3':
                        resultado = agendarCita(citas, usuarios, mascotas, indiceCita);
                        if (resultado.Contains("agendada"))
                        {
                            indiceCita++;
                        }
                        break;
                    case '4':
                        resultado = mostrarCitas(citas);
                        break;
                    case '5':
                        Console.WriteLine("Saliendo del programa.");
                        break;
                    default:
                        resultado = "Comando inválido.";
                        break;
                }
            } while (opc != '5');
            
        }
    }
}
